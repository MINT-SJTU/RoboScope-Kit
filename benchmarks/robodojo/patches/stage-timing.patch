+"""Opt-in host-side stage timings for RoboDojo evaluation.
+
+Enabled only when ROBODOJO_STAGE_TIMING_DIR is set. Wraps existing simulator and
+Policy-client methods with perf_counter timers; it adds no CUDA synchronization
+and changes no inputs, outputs, or call order. Writes under that directory:
+
+- ``<pid>-phases.jsonl``: one line per lifecycle phase (app launch, scene
+  initialization, reset, layout check, settling, execution); layout check and
+  settling run inside reset, so their time also counts toward it.
+- ``<pid>-episode-<n>.json``: per execution batch, one row per nested call path
+  with calls, inclusive and self seconds, and the maximum single call.
+"""
+
+import functools
+import json
+import os
+import threading
+import time
+from contextlib import contextmanager
+from pathlib import Path
+
+_DIRECTORY = os.environ.get("ROBODOJO_STAGE_TIMING_DIR")
+_ACTIVE = False
+_STATS = {}
+_LOCK = threading.Lock()
+_LOCAL = threading.local()
+_METADATA = {}
+_SERIAL = 0
+now = time.perf_counter
+
+
+def enabled():
+    return bool(_DIRECTORY)
+
+
+def _output(name):
+    path = Path(_DIRECTORY)
+    path.mkdir(parents=True, exist_ok=True)
+    return path / name
+
+
+def phase(name, started):
+    """Record a lifecycle phase that began at ``started`` (``now()``)."""
+    if not _DIRECTORY:
+        return
+    record = {"phase": name, "elapsed_s": time.perf_counter() - started, "time_unix_s": time.time()}
+    with _output(f"{os.getpid()}-phases.jsonl").open("a", encoding="utf-8") as stream:
+        stream.write(json.dumps(record) + "\n")
+
+
+def _record(path, elapsed, children, failed):
+    key = (threading.get_ident(), path)
+    with _LOCK:
+        row = _STATS.setdefault(key, {
+            "thread": key[0], "path": path, "calls": 0, "inclusive_s": 0.0, "self_s": 0.0,
+            "max_s": 0.0, "errors": 0,
+        })
+        row["calls"] += 1
+        row["inclusive_s"] += elapsed
+        row["self_s"] += max(0.0, elapsed - children)
+        row["max_s"] = max(row["max_s"], elapsed)
+        row["errors"] += int(failed)
+
+
+def _timed(function, label):
+    if getattr(function, "_roboscope_stage_timing", False):
+        return function
+
+    @functools.wraps(function)
+    def timed(*args, **kwargs):
+        if not _ACTIVE:
+            return function(*args, **kwargs)
+        stack = getattr(_LOCAL, "stack", None)
+        if stack is None:
+            stack = _LOCAL.stack = []
+        path = "/".join([frame[0] for frame in stack] + [label])
+        frame = [label, 0.0]
+        stack.append(frame)
+        started = time.perf_counter()
+        failed = True
+        try:
+            result = function(*args, **kwargs)
+            failed = False
+            return result
+        finally:
+            elapsed = time.perf_counter() - started
+            stack.pop()
+            if stack:
+                stack[-1][1] += elapsed
+            _record(path, elapsed, frame[1], failed)
+
+    timed._roboscope_stage_timing = True
+    return timed
+
+
+def _wrap(owner, name, label):
+    if hasattr(owner, name):
+        setattr(owner, name, _timed(getattr(owner, name), label))
+
+
+def install(env):
+    """Wrap the stages of one evaluation environment; idempotent."""
+    if not _DIRECTORY:
+        return
+    from env.robot_manager.control_manager import MetaControl
+    from utils.save_file import VideoStreamWriter
+
+    _METADATA.update(
+        physics_dt=env.sim.physics_dt,
+        decimation=env.sim.cfg.decimation,
+        render_interval=env.sim.cfg.sim.render_interval,
+        logical_cpus=os.cpu_count(),
+        affinity_cpus=len(os.sched_getaffinity(0)),
+    )
+    for method, label in (
+        ("get_obs", "observation"),
+        ("get_obs_batch", "observation_batch"),
+        ("take_action", "action"),
+        ("take_action_batch", "action_batch"),
+        ("process_control_info", "control_interpolation"),
+        ("step", "control_step"),
+        ("is_episode_end", "termination"),
+        ("_stream_vision", "video_stream"),
+        ("save_video", "video_finalize"),
+        ("sim_step", "physics_substeps"),
+    ):
+        _wrap(env, method, label)
+    for method in ("act", "observe"):
+        _wrap(env.model_client, method, "policy." + method)
+    for method in ("get_joint", "get_end_effector_real_val", "get_real_endpose", "get_link_pose", "control_robot"):
+        _wrap(env.robot_manager, method, "robot." + method)
+    _wrap(MetaControl, "get_action", "control_expand")
+    _wrap(env.obs_manager, "render_for_capture", "camera_fence")
+    _wrap(env.obs_manager, "get_obs", "observation_build")
+    _wrap(env.capture_manager, "step", "camera_readback")
+    for camera in env.capture_manager.tiled_cameras:
+        _wrap(camera, "get_data", "camera_annotator")
+    _wrap(env.sim.sim, "step", "physics_step")
+    _wrap(env.sim.sim, "render", "render")
+    _wrap(env.sim.scene, "write_data_to_sim", "scene_write")
+    _wrap(env.sim.scene, "update", "scene_update")
+    _wrap(env.reward_manager, "step", "reward")
+    _wrap(VideoStreamWriter, "append", "video_append")
+    _wrap(VideoStreamWriter, "close", "video_close")
+
+
+@contextmanager
+def execution():
+    """Collect stage timings for one ``run_eval()`` batch."""
+    global _ACTIVE, _SERIAL
+    if not _DIRECTORY:
+        yield
+        return
+    with _LOCK:
+        _STATS.clear()
+    # A PhysX restart re-executes in place: same pid, serial back at zero.
+    _SERIAL += 1
+    while _output(f"{os.getpid()}-episode-{_SERIAL:03d}.json").exists():
+        _SERIAL += 1
+    started_unix = time.time()
+    started = time.perf_counter()
+    _ACTIVE = True
+    try:
+        yield
+    finally:
+        _ACTIVE = False
+        elapsed = time.perf_counter() - started
+        with _LOCK:
+            rows = sorted((dict(row) for row in _STATS.values()), key=lambda row: row["path"])
+        record = {
+            "pid": os.getpid(),
+            "batch": _SERIAL,
+            "started_unix_s": started_unix,
+            "elapsed_s": elapsed,
+            "clock": "host perf_counter; no added CUDA synchronization; inclusive paths nest",
+            "metadata": _METADATA,
+            "rows": rows,
+        }
+        path = _output(f"{os.getpid()}-episode-{_SERIAL:03d}.json")
+        temporary = path.with_suffix(".tmp")
+        temporary.write_text(json.dumps(record, indent=2), encoding="utf-8")
+        temporary.replace(path)
