+# RoboScope Kit: per-camera (width, height) render sizes negotiated with the Policy.
+# Without ROBODOJO_CAMERA_RESOLUTIONS every camera keeps its template resolution.
+ROBOSCOPE_CAMERA_RESOLUTIONS = {
+    str(name): (int(size[0]), int(size[1]))
+    for name, size in json.loads(os.environ.get("ROBODOJO_CAMERA_RESOLUTIONS") or "{}").items()
+}
+
+
+def roboscope_camera_args(camera_type, camera_name):
+    args_info = REAL_MAP.get(camera_type, None)
+    if args_info is not None and camera_name in ROBOSCOPE_CAMERA_RESOLUTIONS:
+        args_info = {**args_info, "resolution": ROBOSCOPE_CAMERA_RESOLUTIONS[camera_name]}
+    return args_info
+
