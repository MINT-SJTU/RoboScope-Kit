+# The pinned robomimic rollout alternates source and saved XML during reset_to.
+# Assets are immutable in this runtime. Keep two pristine models per process and
+# copy each one before exposing mutable arrays to an environment.
+_XML_MODEL_LOCK = RLock()
+_LAST_COMPILED_XML = None
+
+
+def _compile_xml_model(xml, directory):
+    global _LAST_COMPILED_XML
+    model = mujoco.MjModel.from_xml_string(xml)
+    _LAST_COMPILED_XML = (xml, directory)
+    return model
+
+
+@lru_cache(maxsize=2)
+def _cached_xml_model(xml, directory):
+    return _compile_xml_model(xml, directory)
 
 
