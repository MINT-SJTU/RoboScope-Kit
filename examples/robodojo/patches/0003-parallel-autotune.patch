+            )
+    elif args.workers is not None or args.replicas is not None:
+        parser.error("--workers/--replicas require --mode fixed")
+    args.vulkan_icd = args.vulkan_icd or next(
+        (
+            p
+            for p in (
+                Path("/etc/vulkan/icd.d/nvidia_icd.json"),
