+        text=True,
+        timeout=10,
+    )
+    result = {}
+    for line in query.splitlines():
+        pid, value = (part.strip() for part in line.split(","))
+        if pid.isdigit() and value.isdigit():
+            result[int(pid)] = int(value)
+    return result
