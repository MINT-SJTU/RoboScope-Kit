+                    "idle_vram_mib": item.get("idle_vram_mib"),
+                    "exit_code": item["process"].returncode,
+                }
+                for item in servers
+            ]
+            record["metrics_path"] = str(metrics)
+            gpu_path = output / "gpu.jsonl"
+            samples = (
+                [json.loads(line) for line in gpu_path.read_text().splitlines()] if gpu_path.exists() else []
+            )
+            record["gpu_total"] = gpu_summary(samples, started, stopped)
+            resources = [json.loads(line) for line in (output / "resources.jsonl").read_text().splitlines()]
+            record["resources_total"] = resource_summary(resources, [(started, stopped)])
+            if record.get("complete"):
+                record["resources_evaluation"] = resource_summary(
+                    resources, [(evaluation_start, evaluation_end)]
+                )
+                selected_samples = [
+                    s for s in process_samples if evaluation_start <= s["time_unix_s"] <= evaluation_end
+                ]
+                record["process_vram_evaluation"] = {}
+                for kind, count in (("servers", g), ("workers", k)):
+                    record["process_vram_evaluation"][kind] = {}
+                    for index in range(count):
+                        values = [
+                            s[kind][str(index)] for s in selected_samples if s[kind][str(index)] is not None
+                        ]
+                        record["process_vram_evaluation"][kind][str(index)] = {
+                            "samples": len(values),
+                            "mean_mib": sum(values) / len(values) if values else None,
+                            "peak_mib": max(values) if values else None,
+                        }
+                record["gpu_evaluation"] = gpu_summary(samples, evaluation_start, evaluation_end)
+                if record["gpu_evaluation"] is None:
+                    record["complete"] = False
+                    failure = RuntimeError("GPU evaluation samples missing")
+                    record["error"] = str(failure)
+                record["total_steps_per_s"] = steps / record["total_wall_s"]
+                record["total_episodes_per_s"] = len(rows) / record["total_wall_s"]
+            atomic_json(output / "summary.json", record)
+        if failure:
+            if isinstance(failure, (KeyboardInterrupt, SystemExit)):
+                raise failure
+            if isinstance(failure, sdk.ProbeStopped):
+                raise failure
+            logs = [worker["directory"] / "client.log" for worker in workers] + [s["log"] for s in servers]
+            oom = any("out of memory" in path.read_text(errors="replace").lower() for path in logs)
+            raise sdk.ProbeCapacityReached(
+                str(failure), stop_reason="worker_oom" if oom else "worker_failure"
+            ) from failure
+        gpu = record["gpu_evaluation"]
+        result = dict(
+            episodes=episodes,
+            total_episodes=episodes,
+            successes=successes,
+            success_rate=successes / episodes,
+            steps_per_s=steps / evaluation_s,
+        )
+        progress({**result, "failures": episodes - successes})
+        return {
+            "result": result,
+            # Use the existing SDK's candidate scoring and resource hints.
+            "benchmark": {},
+            "resources": {
+                "cpu": record["cpu_evaluation"],
+                "gpu": {
+                    "mean_utilization": gpu["mean_utilization_percent"] / 100,
+                    "peak_memory_bytes": gpu["peak_memory_mib"] * 1024**2,
+                },
+            },
+            "recovery": {
+                "initial_workers_per_gpu": {"0": k},
+                "final_workers_per_gpu": {"0": k},
+                "worker_failures": [],
+                "oom_events": 0,
+            },
+            "evidence": str(output),
+            "summary": record,
+        }, replica_vram
+
+    @staticmethod
+    def check_servers(servers):
+        for item in servers:
+            process = item["process"]
+            if process.poll() is not None:
+                raise RuntimeError(f"Policy server {item['replica']} exited {process.returncode}")
+
+    @staticmethod
+    def check_deadline(deadline, limits):
+        if time.monotonic() >= deadline:
+            raise sdk.ProbeTimedOut("Probe deadline reached", stop_reason=limits.timeout_reason)
+
