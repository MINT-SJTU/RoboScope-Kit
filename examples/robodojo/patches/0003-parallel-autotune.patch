+    parser.add_argument("--maximum-replicas", type=int, choices=[1, 2], default=1)
+    parser.add_argument("--workers", type=int, choices=[1, 2, 3], help="fixed-mode worker count")
+    parser.add_argument("--replicas", type=int, choices=[1, 2], help="fixed-mode model count")
+    parser.add_argument("--episodes", type=int, default=6, choices=range(1, 51))
+    parser.add_argument("--probe-episodes", type=int, default=6, choices=range(2, 51))
+    parser.add_argument("--env-root", type=Path, default=Path("/workspace/robodojo-envs"))
+    parser.add_argument("--simulator-env", type=Path, default=Path("/workspace/robodojo-envs/simulator"))
+    parser.add_argument("--metrics-root", type=Path, default=Path("/workspace/robodojo-metrics"))
+    parser.add_argument("--vulkan-icd", type=Path)
+    parser.add_argument("--candidate-timeout-s", type=float, default=1800)
+    parser.add_argument("--tune-budget-s", type=float, default=3600)
+    parser.add_argument("--output", type=Path, help="new external directory for this off/on experiment")
+    args = parser.parse_args()
+    if os.environ.get("OMNI_KIT_ACCEPT_EULA", "").upper() not in {"YES", "Y"}:
+        parser.error(
