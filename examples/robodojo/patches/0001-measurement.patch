+"""Opt-in host-side execution timings; never change model inputs or GPU synchronization."""
+
+import cProfile
+import functools
+import importlib
+import inspect
+import json
+import os
+import threading
+import time
+from contextlib import contextmanager
+from pathlib import Path
+
+_ENABLED = os.environ.get("ROBODOJO_EXECUTION_PROFILE") == "1"
+_PHASE = "outside"
+_STATS = {}
+_LOCK = threading.Lock()
+_LOCAL = threading.local()
+_METADATA = {}
+_SERIAL = 0
+
+
+def _record(path, elapsed, children, failed=False, nbytes=0):
+    key = (threading.get_ident(), path)
+    with _LOCK:
+        row = _STATS.setdefault(
+            key,
+            {
+                "thread": key[0],
+                "path": path,
+                "calls": 0,
+                "inclusive_s": 0.0,
+                "self_s": 0.0,
+                "max_s": 0.0,
+                "errors": 0,
+                "bytes": 0,
+            },
+        )
+        row["calls"] += 1
+        row["inclusive_s"] += elapsed
+        row["self_s"] += max(0.0, elapsed - children)
+        row["max_s"] = max(row["max_s"], elapsed)
+        row["errors"] += int(failed)
+        row["bytes"] += nbytes
+
+
+def timed(function, label, *, method_name=False):
+    if getattr(function, "_recipe_profile", False):
+        return function
+    if inspect.iscoroutinefunction(function):
+
+        @functools.wraps(function)
+        async def asynchronous(*args, **kwargs):
+            if _PHASE not in {"execution", "server"}:
+                return await function(*args, **kwargs)
+            started = time.perf_counter()
+            failed = True
+            try:
+                result = await function(*args, **kwargs)
+                failed = False
+                return result
+            finally:
+                # Async intervals may overlap; report inclusive only, separately from sync trees.
+                _record("async/" + label, time.perf_counter() - started, 0.0, failed)
+
+        asynchronous._recipe_profile = True
+        return asynchronous
+
+    @functools.wraps(function)
+    def synchronous(*args, **kwargs):
+        if _PHASE not in {"execution", "server"}:
+            return function(*args, **kwargs)
+        name = label
+        if method_name:
+            name += "." + str(kwargs.get("func_name", args[0] if args else "unknown"))
+        stack = getattr(_LOCAL, "stack", None)
+        if stack is None:
+            stack = _LOCAL.stack = []
+        path = "/".join([frame[0] for frame in stack] + [name])
+        frame = [name, 0.0]
+        stack.append(frame)
+        started = time.perf_counter()
+        failed, size = True, 0
+        try:
+            result = function(*args, **kwargs)
+            failed = False
+            if isinstance(result, (bytes, bytearray, memoryview)):
+                size = len(result)
+            return result
+        finally:
+            elapsed = time.perf_counter() - started
+            stack.pop()
+            if stack:
+                stack[-1][1] += elapsed
+            _record(path, elapsed, frame[1], failed, size)
+
+    synchronous._recipe_profile = True
+    return synchronous
+
+
+def _wrap(owner, name, label, **kwargs):
+    setattr(owner, name, timed(getattr(owner, name), label, **kwargs))
+
+
+def _write(name, started=None):
+    directory = Path(os.environ["ROBODOJO_METRICS_DIR"]) / "execution-profile"
+    directory.mkdir(parents=True, exist_ok=True)
+    with _LOCK:
+        rows = [dict(row) for row in _STATS.values()]
+    record = {
+        "pid": os.getpid(),
+        "time_unix_s": time.time(),
+        "started_unix_s": started,
+        "rows": rows,
+        "metadata": _METADATA,
+        "clock": "host perf_counter; no added CUDA synchronize; inclusive paths nest",
+        "scope": "execution only for simulator; cumulative transport lifetime for server",
+    }
+    path = directory / f"{os.getpid()}-{name}.json"
+    temporary = path.with_suffix(".tmp")
+    temporary.write_text(json.dumps(record, indent=2), encoding="utf-8")
+    temporary.replace(path)
+
+
+@contextmanager
+def execution_scope():
+    global _PHASE, _SERIAL
+    if not _ENABLED:
+        yield
+        return
+    with _LOCK:
+        _STATS.clear()
+    _PHASE = "execution"
+    _SERIAL += 1
+    started = time.time()
+    profiler = cProfile.Profile() if os.environ.get("ROBODOJO_PYTHON_PROFILE") == "1" else None
+    if profiler:
+        profiler.enable()
+    try:
+        yield
+    finally:
+        if profiler:
+            profiler.disable()
+        _PHASE = "outside"
+        _write(f"episode-{_SERIAL:03d}", started)
+        if profiler:
+            directory = Path(os.environ["ROBODOJO_METRICS_DIR"]) / "execution-profile"
+            profiler.dump_stats(str(directory / f"{os.getpid()}-episode-{_SERIAL:03d}.prof"))
+
+
+def install_client(env):
+    from recipe_causal_trace import install_client as install_causal
+
+    install_causal(env)
+    if not _ENABLED:
+        return
+    import carb.settings
+    from env.robot_manager.control_manager import MetaControl
+    from utils.save_file import VideoStreamWriter
+
+    settings = carb.settings.get_settings()
+    keys = (
+        "/app/runLoops/main/rateLimitEnabled",
+        "/app/runLoops/main/rateLimitFrequency",
+        "/app/runLoops/main/rateLimitUseBusyLoop",
+        "/app/renderer/waitIdle",
+        "/app/hydraEngine/waitIdle",
+        "/app/updateOrder/checkForHydraRenderComplete",
+        "/persistent/physics/numThreads",
+        "/physics/physxDispatcher",
+        "/plugins/carb.tasking.plugin/threadCount",
+        "/plugins/omni.tbb.globalcontrol/maxThreadCount",
+        "/physics/updateToUsd",
+        "/physics/updateVelocitiesToUsd",
+        "/physics/outputVelocitiesLocalSpace",
+        "/physics/fabricEnabled",
+    )
+    _METADATA.update(
+        settings={key: settings.get(key) for key in keys},
+        device=str(env.device),
+        physics_dt=env.sim.physics_dt,
+        decimation=env.sim.cfg.decimation,
+        collect_interval=env.obs_manager.collect_interval,
+        render_interval=env.sim.cfg.sim.render_interval,
+        python_profile=os.environ.get("ROBODOJO_PYTHON_PROFILE") == "1",
+        logical_cpus=os.cpu_count(),
+        affinity_cpus=len(os.sched_getaffinity(0)),
+        process_threads=len(list(Path("/proc/self/task").iterdir())),
+        cpu_max=Path("/sys/fs/cgroup/cpu.max").read_text().strip(),
+    )
+    for method, label in (
+        ("get_obs_batch", "observation"),
+        ("take_action_batch", "action"),
+        ("process_control_info", "control_interpolation"),
+        ("step", "control_step"),
+        ("is_episode_end", "termination"),
+        ("_stream_vision", "video_stream"),
+        ("save_video", "video_finalize"),
+    ):
+        _wrap(env, method, label)
+    _wrap(env.model_client, "call", "rpc", method_name=True)
+    for method in (
+        "get_joint",
+        "get_end_effector_real_val",
+        "get_real_endpose",
+        "get_link_pose",
+        "control_robot",
+    ):
+        _wrap(env.robot_manager, method, "robot." + method)
+    _wrap(MetaControl, "get_action", "control_expand")
+    _wrap(env.obs_manager, "render_for_capture", "camera_fence")
+    _wrap(env.obs_manager, "get_obs", "observation_build")
+    _wrap(env.capture_manager, "step", "camera_readback")
+    for camera in env.capture_manager.tiled_cameras:
+        _wrap(camera, "get_data", "camera_annotator")
+    _wrap(env, "sim_step", "physics_substeps")
+    _wrap(env.sim.sim, "step", "physics_step")
+    _wrap(env.sim.sim, "render", "render")
+    _wrap(env.sim.scene, "write_data_to_sim", "scene_write")
+    _wrap(env.sim.scene, "update", "scene_update")
+    _wrap(env.reward_manager, "step", "reward")
+    _wrap(VideoStreamWriter, "append", "video_append")
+    _wrap(VideoStreamWriter, "close", "video_close")
+    module = importlib.import_module("src.eval_client.eval_env")
+    _wrap(module, "deepcopy", "observation_or_control_copy")
+    protocol = importlib.import_module("client_server.ws.protocol.client")
+    for name in ("encode_frame", "decode_envelope"):
+        _wrap(protocol, name, "rpc.client." + name)
+
+
+
+def _install_server_stages(server):
+    """Measure existing FIFO lock/executor boundaries without changing scheduling."""
+    if getattr(server, "_recipe_stages_installed", False):
+        return
+    server._recipe_stages_installed = True
+    invoke = server._invoke_method
+    handle = server._handle_call
+
+    @functools.wraps(server._call_model_method)
+    async def call(method, *args):
+        # Same lock, acquire point, method and release point as the pinned server.
+        # Record after release: no file I/O or metrics mutex inside the model lock.
+        name = getattr(method, "__name__", "unknown")
+        started = time.perf_counter()
+        acquired = None
+        failed = True
+        try:
+            async with server._model_lock:
+                acquired = time.perf_counter()
+                result = await server._invoke_method(method, *args)
+                failed = False
+                return result
+        finally:
+            ended = time.perf_counter()
+            waited = ended - started if acquired is None else acquired - started
+            _record("rpc.stage.lock_wait." + name, waited, 0, acquired is None)
+            if acquired is not None:
+                _record("rpc.stage.lock_held." + name, ended - acquired, 0, failed)
+
+    @functools.wraps(invoke)
+    async def invoked(method, *args):
+        name = getattr(method, "__name__", "unknown")
+        if inspect.iscoroutinefunction(method):
+            return await invoke(method, *args)
+        started = time.perf_counter()
+        marks = {}
+
+        @functools.wraps(method)
+        def body(*values):
+            marks["begin"] = time.perf_counter()
+            try:
+                result = method(*values)
+                marks["awaitable"] = inspect.isawaitable(result)
+                return result
+            finally:
+                marks["end"] = time.perf_counter()
+
+        failed = True
+        try:
+            result = await invoke(body, *args)
+            failed = False
+            return result
+        finally:
+            ended = time.perf_counter()
+            # Cancellation can leave the original executor work running. Do not
+            # report a truncated body or call that interval loop wakeup latency.
+            if "end" in marks:
+                _record("rpc.stage.executor_wait." + name, marks["begin"] - started, 0, failed)
+                _record("rpc.stage.method_body." + name, marks["end"] - marks["begin"], 0, failed)
+                suffix = "awaitable_tail." if marks.get("awaitable") else "return_to_loop."
+                _record("rpc.stage." + suffix + name, ended - marks["end"], 0, failed)
+
+    @functools.wraps(handle)
+    async def handled(frame):
+        name = str(frame.payload.get("func_name", "unknown"))
+        started = time.perf_counter()
+        failed = True
+        try:
+            result = await handle(frame)
+            failed = False
+            return result
+        finally:
+            _record("rpc.stage.handle." + name, time.perf_counter() - started, 0, failed)
+
+    server._call_model_method = call
+    server._invoke_method = invoked
+    server._handle_call = handled
+
+
+def install_server(server):
+    global _PHASE
+    from recipe_causal_trace import install_server as install_causal
+
+    install_causal(server)
+    if not _ENABLED:
+        return
+    _PHASE = "server"
+    _install_server_stages(server)
+    module = importlib.import_module("client_server.ws.model_server")
+    for name in ("encode_frame", "decode_envelope", "decode_frame", "decode_obs_images"):
+        _wrap(module, name, "rpc.server." + name)
+    for name in ("_call_model_method", "_handle_call"):
+        _wrap(server, name, "rpc.server." + name)
