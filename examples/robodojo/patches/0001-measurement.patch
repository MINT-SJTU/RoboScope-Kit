+        meta = _REQUEST.get()
+        if meta is None:
+            raise RuntimeError("Causal trace requires the pinned CALL-only recipe")
+        name = meta["method"]
+        payload = args[0] if args else None
+        scope = meta["scope"]
+        indices = []
+        if name in {"update_obs", "update_obs_batch"}:
+            rows = payload if name.endswith("batch") else [payload]
+            scope = rows[0]["evaluation_id"]
+            indices = [int(row["env_idx"]) for row in rows]
+        elif isinstance(payload, dict):
+            scope = payload.get("evaluation_id", scope)
+            indices = payload.get("env_idx_list", [0])
+        rng = rng_snapshot()
+        before = dict(meta, model_scope=scope, rng=value_digest(rng))
+        if name.startswith("update_obs"):
