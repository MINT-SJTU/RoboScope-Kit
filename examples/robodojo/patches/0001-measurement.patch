+"""Opt-in causal evidence at runtime boundaries; never alter model methods or RNG."""
+
+import functools
+import itertools
+import json
+import os
+import pickle
+import random
+import threading
+import time
+from contextvars import ContextVar
+from pathlib import Path
+
+from recipe_metrics import value_digest
+
+_REQUEST = ContextVar("recipe_causal_request", default=None)
+_RECORDER_IDS = itertools.count()
+
+
+class Recorder:
+    def __init__(self, role):
+        self.root = Path(os.environ["ROBODOJO_CAUSAL_TRACE_DIR"]) / f"{role}-{os.getpid()}-{next(_RECORDER_IDS)}"
+        self.root.mkdir(parents=True, exist_ok=False)
+        self.lock = threading.Lock()
+        self.serial = 0
+        self.payloads = (self.root / "payloads.bin").open("xb", buffering=8 * 1024**2)
+        self.events = (self.root / "events.jsonl").open("x", encoding="utf-8", buffering=1)
+
+    def emit(self, event, *, data=None, **fields):
+        # Synchronous snapshots: no retained mutable buffers or unbounded queue.
+        # This is diagnostic I/O; instrumented timings are not speedup evidence.
+        with self.lock:
+            self.serial += 1
+            row = dict(event=event, seq=self.serial, monotonic_ns=time.monotonic_ns(), **fields)
+            if data is not None:
+                offset = self.payloads.tell()
+                pickle.dump(data, self.payloads, protocol=5)
+                row["data"] = {"offset": offset, "length": self.payloads.tell() - offset}
+                self.payloads.flush()
+            self.events.write(json.dumps(row, allow_nan=False) + "\n")
+            return self.serial
+
