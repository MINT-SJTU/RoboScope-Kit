+def observation_info(rows):
+    return [{
+        "scope": row.get("evaluation_id"), "env_idx": int(row.get("env_idx", 0)),
+        "state": value_digest(row["state"]), "vision": value_digest(row["vision"]),
+        "instruction": value_digest(row["instruction"]),
+        "cameras": {name: value_digest(value["color"]) for name, value in row["vision"].items()},
+    } for row in rows]
+
+
+def rng_snapshot():
+    import numpy as np
+    import torch
+
+    return {
+        "python": random.getstate(), "numpy": np.random.get_state(),
+        "torch_cpu": torch.get_rng_state().numpy().copy(),
+        "torch_cuda": [state.numpy().copy() for state in torch.cuda.get_rng_state_all()]
+        if torch.cuda.is_initialized() else [],
+    }
+
+
+def history_info(model, scope, indices):
+    # Read-only inspection of the pinned adapter, not a replacement for its logic.
+    answer = []
+    for index in indices:
+        queue = model.history._states.get((scope, index), ())
+        latest = model.observations.get((scope, index))
+        answer.append({
+            "scope": scope, "env_idx": index, "length": len(queue),
+            "newest": value_digest(queue[-1]) if queue else None,
+            "frames": [value_digest(frame) if frame is not None else None
+                    for frame in model.history.frames_for(evaluation_id=scope, env_idx=index)],
+            "latest": observation_info([latest])[0] if latest is not None else None,
+        })
+    return answer
