+"""Opt-in external measurements; no model or simulator behavior changes."""
+import hashlib
+import json
+import os
+import time
+from pathlib import Path
+
+
+def emit(event, **fields):
+    directory = os.environ.get("ROBODOJO_METRICS_DIR")
+    if not directory:
+        return
+    path = Path(directory)
+    path.mkdir(parents=True, exist_ok=True)
+    record = {"event": event, "time_unix_s": time.time(), "pid": os.getpid(), **fields}
+    with (path / f"{os.getpid()}.jsonl").open("a", encoding="utf-8") as output:
+        output.write(json.dumps(record, allow_nan=False) + "\n")
+
+
+def value_digest(value):
+    """Hash typed values without modifying or retaining simulator buffers."""
+    import numpy as np
+
+    digest = hashlib.sha256()
+
+    def visit(item):
+        if isinstance(item, np.ndarray):
+            if item.dtype.hasobject:
+                raise TypeError("Object arrays cannot be audited")
+            digest.update(b"array:")
+            digest.update(json.dumps([item.dtype.str, item.shape]).encode())
+            digest.update(np.ascontiguousarray(item).tobytes())
+        elif isinstance(item, dict):
+            digest.update(b"dict:")
+            for key in sorted(item):
+                visit(key)
+                visit(item[key])
+        elif isinstance(item, (list, tuple)):
+            digest.update(f"sequence:{len(item)}:".encode())
+            for child in item:
+                visit(child)
+        else:
+            if isinstance(item, np.generic):
+                item = item.item()
+            digest.update(json.dumps(item, allow_nan=False, sort_keys=True).encode())
+        digest.update(b";")
+
+    visit(value)
+    return digest.hexdigest()
