+        ticket = recorder.emit("model_begin", data={"args": args, "rng": rng}, **before)
+        try:
+            result = await original_invoke(method, *args)
+        except BaseException as error:
+            recorder.emit("model_error", begin=ticket, error=repr(error), **meta)
+            raise
+        rng = rng_snapshot()
+        after = dict(meta, begin=ticket, rng=value_digest(rng), result=value_digest(result))
+        if name.startswith(("update_obs", "reset")):
+            after["history_lengths"] = [
+                {"scope": key[0], "env_idx": key[1], "length": len(queue)}
+                for key, queue in server.model.history._states.items()
+            ]
+        if name.startswith("get_action"):
+            after["action_hashes"] = [[value_digest(action) for action in chunk] for chunk in result]
+        recorder.emit("model_end", data={"result": result, "rng": rng}, **after)
+        return result
+
+    server._handle_call = handle
+    server._invoke_method = invoke
